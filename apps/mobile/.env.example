EXPO_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-dev-key
# Google Maps: restrict each key (web key by HTTP referrer, native key by app id)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-web-maps-js-key
GOOGLE_MAPS_NATIVE_API_KEY=your-native-maps-sdk-key
# Ihssan API (care directory). Must be HTTPS in production.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
