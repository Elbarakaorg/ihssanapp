# Mapbox (public pk. token; restrict it by URL in the Mapbox dashboard)
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token
EXPO_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/your-user/your-style-id
