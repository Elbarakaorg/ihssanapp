{
  "expo": {
    "name": "Ihssan",
    "slug": "ihssan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ihssan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ihssan.app",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ihssan.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "Ihssan uses the microphone so you can record a voice message for a giving case."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2f6f4f"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Ihssan to use your location to find pharmacies, clinics and hospitals near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ihssan to access a profile photo."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Ihssan to count steps and show your activity trends."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ihssan to use the camera to scan QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
